# TOAD Intelligence — environment configuration
#
# Every value here is OPTIONAL. With none of them set the app runs entirely on
# the mock service layer and shows a "Demo Data" indicator throughout the UI.
# Fill these in to swap in real providers; the indicator disappears on its own
# once the corresponding credentials are present.
#
# Copy to `.env.local` (git-ignored) and edit.

# ---------------------------------------------------------------------------
# Chain data — consumed by src/services/solanaDataService.ts
# ---------------------------------------------------------------------------
# Solana JSON-RPC endpoint. A public endpoint works for light use; use a
# dedicated provider (Helius, QuickNode, Triton) for anything real.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Indexer/API that serves aggregated whale flow, holders and trade history.
# Raw RPC cannot answer these queries efficiently on its own.
NEXT_PUBLIC_TOAD_INDEXER_URL=

# The $TOAD SPL mint address.
NEXT_PUBLIC_TOAD_MINT=

# ---------------------------------------------------------------------------
# Price data — consumed by src/services/marketCapService.ts
# ---------------------------------------------------------------------------
# Price/market-cap API base URL (Birdeye, Jupiter, CoinGecko, …).
NEXT_PUBLIC_PRICE_API_URL=

# ---------------------------------------------------------------------------
# Community links — consumed by src/lib/links.ts
# ---------------------------------------------------------------------------
# Used by the "Why $TOAD?" section's CTAs. Left blank, each button renders
# disabled with a "(soon)" tag rather than linking nowhere.
NEXT_PUBLIC_TOAD_X_URL=
NEXT_PUBLIC_TOAD_DEX_URL=

# Exchange name shown in the story section's "Listed On" stat.
# Falls back to the generic "Solana DEXs" when unset.
NEXT_PUBLIC_TOAD_EXCHANGE=
